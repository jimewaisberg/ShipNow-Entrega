
# Puerto del servidor
PORT=8080

# Entorno de ejecución
NODE_ENV=development

# Conexión de ejemplo a MongoDB local
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# Habilita la inserción de mocks solo en desarrollo.
# Mantener en false por defecto para evitar cargas accidentales.
MOCK_SEED_ENABLED=false
