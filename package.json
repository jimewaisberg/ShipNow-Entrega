{
  "name": "shipnow-api",
  "version": "2.0.0",
  "private": true,
  "description": "ShipNow API - Arquitectura por capas, mocks, manejo de errores, logging y documentacion Swagger",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:unit && npm run test:functional",
    "test:unit": "node --require ./test/setup.js --test test/*.test.js",
    "test:functional": "mocha --require ./tests/support.cjs --timeout 120000 \"tests/*.test.cjs\" && npm run test:functional:seed",
    "test:functional:seed": "TEST_ENABLE_SEED=1 mocha --require ./tests/support.cjs --timeout 120000 tests/seed.integration.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.19.2",
    "mongoose-paginate-v2": "^1.8.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
